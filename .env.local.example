# God-Caliber Environment Configuration
# Copy this file to .env.local and fill in your values

# ─── Cloudflare Tunnel (auto-set by npm run dev:tunnel) ───
# VITE_TUNNEL_URL=https://your-tunnel.trycloudflare.com

# ─── TURN Relay Server (for symmetric NAT / strict firewall fallback) ───
# Sign up for free at: https://www.metered.ca/tools/openrelay
# Free tier: 500 GB/month — more than enough for testing
#
# After signing up, you'll receive credentials. Add them here:
# VITE_TURN_URL=turn:global.relay.metered.ca:80
# VITE_TURN_USERNAME=your_api_key
# VITE_TURN_CREDENTIAL=your_api_credential
#
# For TURNS (TLS), use:
# VITE_TURN_URL=turns:global.relay.metered.ca:443?transport=tcp

# ─── Custom PeerJS Signaling Server (optional) ───
# By default, the game uses PeerJS Cloud (0.peerjs.com).
# To use a self-hosted PeerJS server, set these:
# VITE_PEERJS_HOST=your-peerjs-server.com
# VITE_PEERJS_PORT=443
# VITE_PEERJS_PATH=/
